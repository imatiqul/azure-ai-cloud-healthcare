<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />
  <PropertyGroup>
    <RootNamespace>HealthQCopilot.AppHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- From Aspire 13.5 every build of an application host that does not use the Aspire CLI bundle raises
         warning ASPIRE010. This host keeps taking the dashboard and the orchestrator (DCP) from NuGet, as it
         did on 9.3.0, so nobody has to install the Aspire CLI to build or run it. Aspire 17 makes the CLI
         bundle mandatory for C# application hosts (ASPIRE013); decide that with the next upgrade. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <!-- Aspire.Hosting.NodeJs was renamed to Aspire.Hosting.JavaScript in Aspire 13.0. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HealthQCopilot.Identity\HealthQCopilot.Identity.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Voice\HealthQCopilot.Voice.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Agents\HealthQCopilot.Agents.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Fhir\HealthQCopilot.Fhir.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Ocr\HealthQCopilot.Ocr.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Scheduling\HealthQCopilot.Scheduling.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Notifications\HealthQCopilot.Notifications.csproj" />
    <ProjectReference Include="..\HealthQCopilot.PopulationHealth\HealthQCopilot.PopulationHealth.csproj" />
    <ProjectReference Include="..\HealthQCopilot.RevenueCycle\HealthQCopilot.RevenueCycle.csproj" />
    <ProjectReference Include="..\HealthQCopilot.Gateway\HealthQCopilot.Gateway.csproj" />
    <ProjectReference Include="..\HealthQCopilot.BFF\HealthQCopilot.BFF.csproj" />
  </ItemGroup>

</Project>
